# ---- Storefront API (client-safe, browser-e use hoy) ----
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token
SHOPIFY_STOREFRONT_API_VERSION=2024-07

# ---- Admin API (SECRET — kokhono NEXT_PUBLIC_ prefix use korben na) ----
# Shopify Admin -> Settings -> Apps and sales channels -> Develop apps
# -> [app] -> API credentials -> Admin API access token
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=your-admin-api-token

# ---- Read-only admin dashboard gate password ----
ADMIN_DASHBOARD_PASSWORD=set-a-strong-password-here
